FROM php:8.2-cli

# ── Install system dependencies ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    unzip \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libonig-dev \
    libxml2-dev \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# ── Install PHP extensions ───────────────────────────────────────────────────
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_mysql \
        mysqli \
        mbstring \
        gd \
        zip \
        fileinfo

# ── Install Node.js 20 ───────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── PHP configuration ─────────────────────────────────────────────────────────
RUN echo "upload_max_filesize = 15M\n\
post_max_size = 15M\n\
max_execution_time = 120\n\
memory_limit = 256M\n\
display_errors = Off\n\
log_errors = On" > /usr/local/etc/php/conf.d/resumeiqx.ini

# ── Set working directory ─────────────────────────────────────────────────────
WORKDIR /var/www/html

# ── Copy project files ────────────────────────────────────────────────────────
COPY . .

# ── Install Node.js dependencies ──────────────────────────────────────────────
RUN cd node_api && npm install --omit=dev --legacy-peer-deps || true

# ── Install Python dependencies ───────────────────────────────────────────────
RUN cd ai_engine_python && \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir PyMuPDF pdfplumber requests python-dotenv || true

# ── Create necessary directories ──────────────────────────────────────────────
RUN mkdir -p uploads/resumes \
    && mkdir -p ai_engine_python/uploads/resumes \
    && mkdir -p ai_engine_python/analysis_outputs

# ── Set permissions ───────────────────────────────────────────────────────────
RUN chmod -R 755 /var/www/html

# ── Copy startup script ───────────────────────────────────────────────────────
COPY start.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/start.sh

# ── Expose port ───────────────────────────────────────────────────────────────
EXPOSE ${PORT}

# ── Start services ────────────────────────────────────────────────────────────
CMD ["/usr/local/bin/start.sh"]
