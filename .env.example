# ResumeIQ-X Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

APP_ENV=development
APP_NAME=ResumeIQ-X
APP_URL=http://localhost
APP_SECRET_KEY=generate_a_random_64_char_string_here

DB_HOST=your_db_host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

NODE_API_PORT=5000
NODE_API_URL=http://127.0.0.1:5000

# Windows: ai_engine_python/venv/Scripts/python.exe
# Linux/Mac: ai_engine_python/venv/bin/python3
PYTHON_EXECUTABLE=ai_engine_python/venv/Scripts/python.exe
PYTHON_PIPELINE_SCRIPT=ai_engine_python/pipelines/run_analysis.py

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME=ResumeIQ-X
MAIL_FROM_ADDRESS=noreply@resumeiqx.ai

# ============================================
# SMS GATEWAY (Choose one: twilio, msg91, fast2sms, or none)
# ============================================
SMS_GATEWAY=none

# ── TWILIO (International) ──
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── MSG91 (India) ──
# Get credentials from: https://msg91.com/
MSG91_AUTH_KEY=your_auth_key
MSG91_SENDER_ID=RSMIQX
MSG91_TEMPLATE_ID=your_template_id

# ── FAST2SMS (India) ──
# Get API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_api_key
FAST2SMS_SENDER_ID=RSMIQX

# ============================================
# SECURITY
# ============================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,txt,doc,docx,png,jpg,jpeg
